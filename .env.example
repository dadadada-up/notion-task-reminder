# Notion 配置
NOTION_TOKEN="your_notion_token_here"
DATABASE_ID="your_database_id_here"

# 消息推送配置（可选）
PUSHPLUS_TOKEN=""
WXPUSHER_TOKEN=""
WXPUSHER_UID=""

# 邮箱推送配置（可选）
EMAIL_ENABLED="false"
EMAIL_SMTP_SERVER="smtp.163.com"
EMAIL_SMTP_PORT="465"
EMAIL_SENDER="your_email@163.com"
EMAIL_PASSWORD=""  # 163邮箱授权码，不是密码
EMAIL_RECEIVER="your_email@163.com"

# 运行配置
REMINDER_TYPE="daily_todo"
SEND_TIME="08:00"
ACTION_TYPE="prepare"
DEBUG_MODE="false"
FORCE_SEND="false"
