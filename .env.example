# Notion 配置
NOTION_TOKEN="your_notion_token_here"
DATABASE_ID="your_database_id_here"

# 消息推送配置（可选）
PUSHPLUS_TOKEN=""
WXPUSHER_TOKEN=""
WXPUSHER_UID=""

# 邮箱推送配置（可选）
EMAIL_ENABLED="false"
EMAIL_SMTP_SERVER="smtp.163.com"
EMAIL_SMTP_PORT="465"
EMAIL_SENDER="your_email@163.com"
# 注意：EMAIL_PASSWORD 应填写邮箱授权码，不是邮箱密码
EMAIL_PASSWORD=""
EMAIL_RECEIVER="your_email@163.com"

# Web 服务配置
PORT="5000"
FLASK_DEBUG="false"

# GitHub 配置（用于自动更新 workflow）
GITHUB_TOKEN="your_github_personal_access_token"
GITHUB_REPOSITORY="username/notion-task-reminder"

# 运行配置
REMINDER_TYPE="daily_todo"
SEND_TIME="08:00"
ACTION_TYPE="prepare"
DEBUG_MODE="false"
FORCE_SEND="false"

# DeepSeek AI 配置（可选）
DEEPSEEK_API_KEY=""
DEEPSEEK_ENABLED="false"
