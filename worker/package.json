{
  "name": "workbench-worker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute workbench-db --file=src/db/schema.sql",
    "db:migrate-status": "wrangler d1 execute workbench-db --remote --file=scripts/migrate-task-status.sql",
    "db:migrate-status:local": "wrangler d1 execute workbench-db --local --file=scripts/migrate-task-status.sql"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "@hono/zod-validator": "^0.9.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
